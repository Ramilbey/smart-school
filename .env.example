# Smart Schools — environment variables
# Copy to .env and fill in real values. Never commit .env.

# --- Telegram bot (required for the bot) ---
# Token from @BotFather (/newbot). Keep it secret.
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-bot-token

# Public HTTPS address where the Mini App is served (must start with https://).
# With the website built (npm run build:site) the Mini App lives at /app/, so write https://your-host.example.com/app/
# Without the website build the Mini App is at the root: https://your-host.example.com
MINI_APP_URL=https://your-app.example.com/app/

# Optional: direct Mini App link registered with BotFather /newapp,
# used in /help text and printed for the deck QR code. Example: https://t.me/your_bot/app
MINI_APP_DIRECT_LINK=

# Bot update mode: "polling" (default, no public URL needed) or "webhook".
BOT_MODE=polling
# Webhook mode only: random string; Telegram sends it back in a header so we can verify requests.
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-string
# Webhook mode only, optional: defaults to <MINI_APP_URL origin>/telegram/webhook
WEBHOOK_URL=

# Set the bot's menu button to open the Mini App on startup (true/false).
BOT_SET_MENU_BUTTON=true

# --- Server ---
PORT=8787
# Optional. Listen on this address only. Behind nginx on the same machine use 127.0.0.1 (the default is every address).
HOST=
# Serve the built Mini App from ./dist (true) or run the API only (false).
SERVE_STATIC=true
# Folder of the built website (npm run build:site). When it exists it is served at "/" and the Mini App at "/app/".
SITE_DIR=dist-site
# Comma-separated extra origins allowed to call the API (only needed if the Mini App is hosted elsewhere).
CORS_ORIGINS=
# Allow API calls without Telegram initData (browser development only). Keep false in production.
ALLOW_DEV_AUTH=false
# Telegram user ids (comma-separated) allowed to open the homework report on the teacher dashboard.
# Everyone else gets 403 and sees the labelled sample report. Find your id with @userinfobot.
TEACHER_IDS=
# Max age of Telegram initData in seconds before it is rejected.
INIT_DATA_MAX_AGE=86400

# Let EVERY Telegram user open the teacher report (a demo or an MVP). They see the other students' progress without names.
# Leave it off in a real pilot and list the teachers in TEACHER_IDS instead.
TEACHER_OPEN=false

# --- AI tutor (optional) ---
# Without a key, the tutor uses the curated, predefined hint flows, and the bot chat runs on fixed rules only.
# Restart the server after changing this.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# AI answers one student can ask for in the bot chat per day. 0 turns them off. Blank means 20.
AI_QUESTIONS_PER_DAY=20

# --- Evening streak reminders (bot) ---
# One friendly message per day to students whose Grade 7 streak is alive but who have not practised today.
# Sent from REMINDER_HOUR until 22:00 in REMINDER_TZ. Students can stop them with /reminders off.
REMINDERS=true
REMINDER_HOUR=19
REMINDER_TZ=Asia/Tashkent

# --- Teacher portal (the website: teacher accounts, quizzes, live games) ---
# Secret that signs teacher login tokens. Blank = a random one is made once and kept in data/portal-secret.txt.
# Set it yourself if you run more than one server process. Changing it logs every teacher out.
PORTAL_SECRET=
# Can teachers create their own accounts on the website? (true/false)
PORTAL_SIGNUP=true
# A ready-made teacher "ustoz" for trying it out. On by default for development, OFF when NODE_ENV=production
# unless you set PORTAL_DEMO=true. The password is a development default: set your own or switch it off.
PORTAL_DEMO=
PORTAL_DEMO_PASSWORD=ustoz2026
# Let web pages from this computer or the school network (localhost, 192.168.x.x, 10.x.x.x) call the API.
# On by default for development, OFF when NODE_ENV=production unless set to true.
CORS_ALLOW_LAN=
# Set true only behind a reverse proxy you control, so the real client address is read from X-Forwarded-For.
TRUST_PROXY=false

# --- Mini App build-time (frontend) ---
# Only needed when the Mini App is hosted separately from the API server.
# Leave empty to call the API on the same origin.
VITE_API_BASE=

# --- The whiteboard can use Google Gemini instead of Claude (free-tier keys work) ---
# Several keys separated by commas: the next one is used when one is out of quota. Used when there is no ANTHROPIC_API_KEY.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3-flash-preview
# Tried in this order when the main model answers "503, high demand" (comma separated; empty = none).
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.1-flash-lite
GEMINI_THINKING=minimal
# AI_PROVIDER=auto  (auto = Claude if it has a key, else Gemini; or anthropic / gemini)

# --- The server voice (edge-tts): the lesson is heard even where the browser has no voices, and in Uzbek ---
# Found automatically at ./tts-venv/bin/edge-tts, /usr/local/bin/edge-tts or ~/.local/bin/edge-tts; or set the path here.
# TTS_BIN=/opt/smart-schools/tts-venv/bin/edge-tts
# TTS_DISABLED=true
# Sentences the server may voice in a day, everybody together.
BOARD_GLOBAL_TTS=6000

# --- The whiteboard tutor and explainer (daily allowances; Tashkent day) ---
# BOARD_ANONYMOUS=true lets a visitor without a Telegram login use it (counted by address).
BOARD_ANONYMOUS=true
BOARD_USER_LESSONS=8
BOARD_USER_TURNS=60
BOARD_ANON_LESSONS=3
BOARD_ANON_TURNS=12
# Everybody together, so a surprise crowd cannot run up the bill.
BOARD_GLOBAL_LESSONS=300
BOARD_GLOBAL_TURNS=1500
